["import jsPDF from 'jspdf';","import { Member, ProfitDistribution } from '@/contexts/OrganizationContext';","import { formatDate } from '@/lib/utils';","","export interface ReportData {","  members: Member[];","  totalContributions: number;","  totalLoans: number;","  totalLoanRecovered: number;","  reserveFund: number;","  organizationName: string;","  currentDate: string;","}","","export interface Settings {","  applyLoanInterest: boolean;","  loanInterestRate: number;","  organizationName: string;","}","","export interface Meeting {","  date: string;","  agenda: string;","  decisions: string;","  contributions?: Array<{ memberId: number; amount: number; present: boolean }>;","  loanCollections?: Array<{ memberId: number; loanId: number; amount: number }>;","  loanIssues?: Array<{ memberId: number; loanId?: number; amount: number }>;","  reserveFundDonations?: Array<{ donorName?: string; amount: number; notes?: string }>;","}","","function genRef(prefix: string): string {","  return prefix+\"-\"+new Date().getFullYear()+\"-\"+String(Date.now()).slice(-6);","}","","const MSO_LOGO_SVG = ","  \"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"40\" viewBox=\"0 0 120 40\">\"+","  \"<rect width=\"120\" height=\"40\" rx=\"4\" fill=\"#1a3a5c\"/>\"+","  \"<text x=\"10\" y=\"27\" font-family=\"Arial,sans-serif\" font-size=\"20\" font-weight=\"bold\" fill=\"#ffffff\">MSO</text>\"+","  \"<line x1=\"60\" y1=\"8\" x2=\"60\" y2=\"32\" stroke=\"#4a9fd4\" stroke-width=\"1.5\"/>\"+","  \"<text x=\"65\" y=\"18\" font-family=\"Arial,sans-serif\" font-size=\"7\" fill=\"#a0c8e8\">MUTUAL SAVINGS</text>\"+","  \"<text x=\"65\" y=\"28\" font-family=\"Arial,sans-serif\" font-size=\"7\" fill=\"#a0c8e8\">ORGANIZATION</text>\"+","  \"</svg>\";","","export class PDFReports {","  private doc: jsPDF;","  private pageWidth: number;","  private pageHeight: number;","  private margin: number;","  private currentY: number;","","  constructor() {","    this.doc = new jsPDF({ orientation: \"portrait\", unit: \"mm\", format: \"a4\" });","    this.pageWidth = this.doc.internal.pageSize.getWidth();","    this.pageHeight = this.doc.internal.pageSize.getHeight();","    this.margin = 18;","    this.currentY = this.margin;","  }","","  private addLogo() {","    try {","      const uri = \"data:image/svg+xml;charset=utf-8,\" + encodeURIComponent(MSO_LOGO_SVG);","      this.doc.addImage(uri, \"SVG\", this.margin, this.currentY, 38, 13);","    } catch {","      this.doc.setFontSize(14);","      this.doc.setFont(\"helvetica\", \"bold\");","      this.doc.setTextColor(26, 58, 92);","      this.doc.text(\"MSO\", this.margin, this.currentY + 9);","      this.doc.setTextColor(0, 0, 0);","    }","  }","","  private addPageFooters(reportRef: string) {","    const total = this.doc.getNumberOfPages();","    for (let i = 1; i <= total; i++) {","      this.doc.setPage(i);","      this.doc.setDrawColor(180, 180, 180);","      this.doc.setLineWidth(0.3);","      this.doc.line(this.margin, this.pageHeight - 12, this.pageWidth - this.margin, this.pageHeight - 12);","      this.doc.setFontSize(7.5);","      this.doc.setFont(\"helvetica\", \"normal\");","      this.doc.setTextColor(120, 120, 120);","      this.doc.text(`Ref: ${reportRef}  |  Generated: ${formatDate(new Date())}  |  CONFIDENTIAL`, this.margin, this.pageHeight - 7);","      this.doc.text(`Page ${i} of ${total}`, this.pageWidth - this.margin, this.pageHeight - 7, { align: \"right\" });","      this.doc.setTextColor(0, 0, 0);","    }","  }","","  private addHeader(title: string, orgName: string, subtitle?: string) {","    this.addLogo();","    this.doc.setFontSize(15);","    this.doc.setFont(\"helvetica\", \"bold\");","    this.doc.setTextColor(26, 58, 92);","    this.doc.text(orgName || \"MSO\", this.pageWidth - this.margin, this.currentY + 5, { align: \"right\" });","    this.doc.setFontSize(9);","    this.doc.setFont(\"helvetica\", \"normal\");","    this.doc.setTextColor(80, 80, 80);","    if (subtitle) {","      this.doc.text(subtitle, this.pageWidth - this.margin, this.currentY + 11, { align: \"right\" });","    }","    this.currentY += 17;","    this.doc.setTextColor(0, 0, 0);","    this.doc.setDrawColor(26, 58, 92);","    this.doc.setLineWidth(0.7);","    this.doc.line(this.margin, this.currentY, this.pageWidth - this.margin, this.currentY);","    this.currentY += 1;","    this.doc.setFillColor(26, 58, 92);","    this.doc.rect(this.margin, this.currentY, this.pageWidth - 2 * this.margin, 8, \"F\");","    this.doc.setFontSize(10);","    this.doc.setFont(\"helvetica\", \"bold\");","    this.doc.setTextColor(255, 255, 255);","    this.doc.text(title.toUpperCase(), this.pageWidth / 2, this.currentY + 5.5, { align: \"center\" });","    this.doc.setTextColor(0, 0, 0);","    this.currentY += 12;","  }","","  private checkPageBreak(space = 20) {","    if (this.currentY + space > this.pageHeight - 18) {","      this.doc.addPage();","      this.currentY = this.margin;","    }","  }","","  private sectionTitle(text: string) {","    this.checkPageBreak(14);","    this.doc.setFontSize(9.5);","    this.doc.setFont(\"helvetica\", \"bold\");","    this.doc.setTextColor(26, 58, 92);","    this.doc.text(text, this.margin, this.currentY);","    this.currentY += 5;","    this.doc.setDrawColor(26, 58, 92);","    this.doc.setLineWidth(0.3);","    this.doc.line(this.margin, this.currentY, this.margin + 60, this.currentY);","    this.currentY += 4;","    this.doc.setTextColor(0, 0, 0);","  }","","  private infoGrid(pairs: [string, string][], cols = 2) {","    const colW = (this.pageWidth - 2 * this.margin) / cols;","    let col = 0;","    pairs.forEach(([label, value]) => {","      const x = this.margin + col * colW;","      this.doc.setFontSize(8);","      this.doc.setFont(\"helvetica\", \"bold\");","      this.doc.setTextColor(80, 80, 80);","      this.doc.text(label + \":\", x, this.currentY);","      this.doc.setFont(\"helvetica\", \"normal\");","      this.doc.setTextColor(0, 0, 0);","      this.doc.text(value, x + 30, this.currentY);","      col++;","      if (col >= cols) { col = 0; this.currentY += 6; }","    });","    if (col !== 0) this.currentY += 6;","    this.currentY += 3;","  }","","  private signatureBlock(labels: string[]) {","    this.checkPageBreak(24);","    this.currentY += 8;","    const w = (this.pageWidth - 2 * this.margin) / labels.length;","    labels.forEach((label, i) => {","      const x = this.margin + i * w;","      this.doc.setDrawColor(100, 100, 100);","      this.doc.setLineWidth(0.4);","      this.doc.line(x, this.currentY, x + w - 8, this.currentY);","      this.doc.setFontSize(7.5);","      this.doc.setFont(\"helvetica\", \"normal\");","      this.doc.setTextColor(80, 80, 80);","      this.doc.text(label, x, this.currentY + 4);","      this.doc.setTextColor(0, 0, 0);","    });","    this.currentY += 10;","  }","","  private addTable(headers: string[], data: string[][], columnWidths?: number[], totalsRow?: string[]) {","    const tableWidth = this.pageWidth - 2 * this.margin;","    const weights = columnWidths ?? headers.map(() => 1);","    const totalWeight = weights.reduce((s, w) => s + w, 0);","    const widths = weights.map((w) => (w / totalWeight) * tableWidth);","    const fontSize = 8.5;","    const padding = 2;","    const lh = (fontSize * this.doc.getLineHeightFactor()) / this.doc.internal.scaleFactor;","    const layoutRow = (cells: string[], bold: boolean) => {","      this.doc.setFontSize(fontSize);","      this.doc.setFont(\"helvetica\", bold ? \"bold\" : \"normal\");","      const lines = cells.map((c, i) => this.doc.splitTextToSize(String(c ?? \"\"), widths[i] - 2 * padding));","      const height = Math.max(1, ...lines.map((l) => l.length)) * lh + 2 * padding;","      return { lines, height, bold };","    };","    const drawRow = (row: ReturnType<typeof layoutRow>, fill?: [number,number,number], textColor?: [number,number,number]) => {","      this.doc.setFontSize(fontSize);","      this.doc.setFont(\"helvetica\", row.bold ? \"bold\" : \"normal\");","      if (fill) { this.doc.setFillColor(...fill); this.doc.rect(this.margin, this.currentY, tableWidth, row.height, \"F\"); }","      if (textColor) this.doc.setTextColor(...textColor);","      let x = this.margin;","      row.lines.forEach((cellLines, i) => {","        this.doc.text(cellLines, x + padding, this.currentY + padding, { baseline: \"top\" });","        x += widths[i];","      });","      this.doc.setTextColor(0, 0, 0);","      this.currentY += row.height;","    };","    const headerRow = layoutRow(headers, true);","    const drawHeader = () => {","      drawRow(headerRow, [26, 58, 92], [255, 255, 255]);","      this.doc.setDrawColor(200, 200, 200);","      this.doc.setLineWidth(0.2);","      this.doc.line(this.margin, this.currentY, this.margin + tableWidth, this.currentY);","    };","    const rows = data.map((cells) => layoutRow(cells, false));","    this.checkPageBreak(headerRow.height + (rows[0]?.height ?? 0));","    drawHeader();","    rows.forEach((row, idx) => {","      if (this.currentY + row.height > this.pageHeight - 18) { this.doc.addPage(); this.currentY = this.margin; drawHeader(); }","      drawRow(row, idx % 2 === 1 ? [245, 248, 252] : undefined);","      this.doc.setDrawColor(220, 220, 220);","      this.doc.setLineWidth(0.1);","      this.doc.line(this.margin, this.currentY, this.margin + tableWidth, this.currentY);","    });","    if (totalsRow) { const tRow = layoutRow(totalsRow, true); this.checkPageBreak(tRow.height); drawRow(tRow, [220, 230, 242]); }","    this.doc.setFont(\"helvetica\", \"normal\");","    this.currentY += 4;","  }","","  // ── REPORT GENERATORS ──────────────────────────────────────────────","","  generateMemberLedger(member: Member, settings: Settings) {","    this.doc = new jsPDF({ orientation: \"portrait\", unit: \"mm\", format: \"a4\" });","    this.currentY = this.margin;","    const ref = genRef(\"ML\");","    this.addHeader(\"Member Account Ledger\", settings.organizationName || \"MSO\", \"Period: All Time\");","    this.sectionTitle(\"Member Information\");","    this.infoGrid([","      [\"Full Name\", member.name],","      [\"Father Name\", member.fatherName || \"-\"],","      [\"Phone\", member.phone || \"-\"],","      [\"Email\", member.email || \"-\"],","      [\"Join Date\", formatDate(member.joinDate)],","      [\"Total Budget\", `PKR ${member.totalBudget.toLocaleString()}`],","    ]);","    if (member.monthlyContributions.length > 0) {","      this.sectionTitle(\"Contribution Ledger\");","      const total = member.monthlyContributions.reduce((s, c) => s + c.amount, 0);","      this.addTable(","        [\"#\", \"Period\", \"Amount (PKR)\", \"Status\"],","        member.monthlyContributions.map((c, i) => [String(i+1), formatDate(c.month), c.amount.toLocaleString(), c.paid ? \"Paid\" : \"Pending\"]),","        [5, 35, 30, 20],","        [\"\", \"TOTAL\", total.toLocaleString(), \"\"]","      );","    }","    if (member.loans.length > 0) {","      this.sectionTitle(\"Loan Account Summary\");","      const rate = settings.applyLoanInterest ? settings.loanInterestRate : 0;","      const totalPrincipal = member.loans.reduce((s, l) => s + l.amount, 0);","      const totalPayable = member.loans.reduce((s, l) => s + l.amount * (1 + rate / 100), 0);","      const totalRemaining = member.loans.reduce((s, l) => s + l.remainingAmount, 0);","      if (rate > 0) {","        this.doc.setFontSize(8); this.doc.setFont(\"helvetica\", \"italic\"); this.doc.setTextColor(100,100,100);","        this.doc.text(`* Interest rate applied: ${rate}% flat`, this.margin, this.currentY);","        this.currentY += 5; this.doc.setTextColor(0,0,0);","      }","      this.addTable(","        [\"#\", \"Loan Date\", \"Principal (PKR)\", \"Payable (PKR)\", \"Outstanding (PKR)\", \"Status\"],","        member.loans.map((l, i) => [String(i+1), formatDate(l.date), l.amount.toLocaleString(), (l.amount*(1+rate/100)).toLocaleString(), l.remainingAmount.toLocaleString(), l.status]),","        [5, 25, 28, 28, 28, 18],","        [\"\", \"TOTAL\", totalPrincipal.toLocaleString(), totalPayable.toLocaleString(), totalRemaining.toLocaleString(), \"\"]","      );","    }","    this.signatureBlock([\"Prepared By\", \"Verified By\", \"Member Signature\"]);","    this.addPageFooters(ref);","    return this.doc;","  }","","  generateMemberDirectory(members: Member[], settings?: Settings) {","    this.doc = new jsPDF({ orientation: \"portrait\", unit: \"mm\", format: \"a4\" });","    this.currentY = this.margin;","    const ref = genRef(\"MD\");","    this.addHeader(\"Member Directory\", settings?.organizationName || \"MSO\", `Total Members: ${members.length}`);","    const sorted = [...members].sort((a, b) => a.name.localeCompare(b.name));","    if (sorted.length > 0) {","      this.addTable(","        [\"#\", \"Full Name\", \"Father Name\", \"Phone\", \"Email\", \"Join Date\"],","        sorted.map((m, i) => [String(i+1), m.name, m.fatherName || \"-\", m.phone || \"-\", m.email || \"-\", formatDate(m.joinDate)]),","        [5, 28, 28, 22, 38, 20]","      );","    } else {","      this.doc.setFontSize(10); this.doc.text(\"No members found.\", this.margin, this.currentY);","    }","    this.signatureBlock([\"Prepared By\", \"Authorized By\"]);","    this.addPageFooters(ref);","    return this.doc;","  }"]